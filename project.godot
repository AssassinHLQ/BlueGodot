; Godot 4.7 standalone theme-plugin demo project.
; Copy addons/blue_archive_editor_theme into another project's res://addons directory.

config_version=5

[application]

config/name="Blue Archive Editor Theme"
config/description="Standalone forced-light Blue Archive inspired editor theme and live control preview."
config/version="2.0.0"
run/main_scene="res://addons/blue_archive_editor_theme/preview/theme_preview.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1100
window/size/viewport_height=700
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/blue_archive_editor_theme/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.917, 0.953, 0.98, 1)
