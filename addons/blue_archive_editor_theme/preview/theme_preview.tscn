[node name="Code" type="CodeEdit" parent="Scroll/Margins/Content/Tabs/Script/ScriptBox"]
layout_mode = 2
size_flags_vertical = 3
text = "@tool
extends EditorPlugin

func _enter_tree() -> void:
    var theme := preload(\"res://theme.tres\")
    EditorInterface.get_editor_theme().merge_with(theme)
    print(\"Theme ready\")

func _exit_tree() -> void:
    pass
"

